# Copier en .env et renseigner. Ne pas committer .env.

# Domaine servi par Caddy (HTTPS automatique via Let's Encrypt)
DOMAIN=horus.example.com

# URL publique canonique utilisee pour sitemap.xml, robots.txt, llms.txt,
# Open Graph et Twitter Cards. Si vide, le serveur utilise DOMAIN puis les
# en-tetes du reverse proxy.
PUBLIC_SITE_URL=
VITE_PUBLIC_SITE_URL=

# Super admin créé au tout premier démarrage.
# Depuis la connexion par email, ADMIN_EMAIL est l'adresse utilisée pour se connecter.
# Pour récupérer un ancien compte, garder ADMIN_LOGIN égal à l'ancien login
# historique (souvent "admin") et renseigner ADMIN_EMAIL.
# Laisser ADMIN_PASSWORD vide pour un mot de passe généré (affiché une fois
# dans les logs : `docker compose logs app`).
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@example.com
ADMIN_CONTACT_EMAIL=
ADMIN_PASSWORD=

# Désactiver avec false si vous ne voulez pas d'auto-inscription publique.
ALLOW_REGISTRATION=true
